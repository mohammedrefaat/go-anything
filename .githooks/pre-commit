#!/bin/sh
#
# go-anything pre-commit hook
# Runs on every commit to catch issues early.
# Install: git config core.hooksPath .githooks
#
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

printf "${YELLOW}[pre-commit]${NC} Running checks...\n"

# ---------------------------------------------------------------------------
# 1. Block commits of .go-anything/local/ (leases/locks must stay gitignored)
# ---------------------------------------------------------------------------
if git diff --cached --name-only | grep -q '^\.go-anything/local/'; then
    printf "${RED}[pre-commit] BLOCKED:${NC} Files under .go-anything/local/ must never be committed.\n"
    printf "  These are ephemeral leases and locks (Rule 1 / ADR-002).\n"
    printf "  Run: git reset HEAD .go-anything/local/\n"
    exit 1
fi

# ---------------------------------------------------------------------------
# 2. Check that staged Go files are properly formatted
# ---------------------------------------------------------------------------
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -n "$STAGED_GO_FILES" ]; then
    UNFORMATTED=$(gofmt -l $STAGED_GO_FILES 2>/dev/null || true)
    if [ -n "$UNFORMATTED" ]; then
        printf "${RED}[pre-commit] BLOCKED:${NC} These files need gofmt:\n"
        for f in $UNFORMATTED; do
            printf "  - %s\n" "$f"
        done
        printf "\n  Fix: gofmt -s -w .\n"
        exit 1
    fi
    printf "${GREEN}  ✓${NC} gofmt\n"

    # -----------------------------------------------------------------------
    # 3. go vet on changed packages
    # -----------------------------------------------------------------------
    PACKAGES=$(echo "$STAGED_GO_FILES" | xargs -I{} dirname {} | sort -u | sed 's|^|./|')
    if [ -n "$PACKAGES" ]; then
        if ! go vet $PACKAGES > /dev/null 2>&1; then
            printf "${RED}[pre-commit] BLOCKED:${NC} go vet found issues:\n"
            go vet $PACKAGES 2>&1 | head -30
            exit 1
        fi
        printf "${GREEN}  ✓${NC} go vet\n"
    fi
fi

# ---------------------------------------------------------------------------
# 4. Check for common secret patterns in staged diffs
# ---------------------------------------------------------------------------
SECRET_PATTERNS='(PRIVATE KEY|password\s*=|api_key\s*=|secret\s*=|token\s*=|AWS_SECRET|AKIA[0-9A-Z]{16})'
SECRETS_FOUND=$(git diff --cached -U0 --diff-filter=ACM | grep -iE "$SECRET_PATTERNS" | grep '^+' | grep -v '^+++' || true)

if [ -n "$SECRETS_FOUND" ]; then
    printf "${YELLOW}[pre-commit] WARNING:${NC} Possible secrets in staged changes:\n"
    echo "$SECRETS_FOUND" | head -5
    printf "\n  If these are test fixtures, proceed with: git commit --no-verify\n"
    printf "  Otherwise, remove them before committing.\n"
    exit 1
fi

# ---------------------------------------------------------------------------
# 5. Verify go.mod / go.sum consistency
# ---------------------------------------------------------------------------
if git diff --cached --name-only | grep -qE '(go\.mod|go\.sum)'; then
    if ! go mod verify > /dev/null 2>&1; then
        printf "${RED}[pre-commit] BLOCKED:${NC} go mod verify failed.\n"
        printf "  Run: go mod tidy\n"
        exit 1
    fi
    printf "${GREEN}  ✓${NC} go mod verify\n"
fi

printf "${GREEN}[pre-commit]${NC} All checks passed.\n"

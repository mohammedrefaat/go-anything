#!/bin/sh
#
# go-anything commit-msg hook
# Validates commit message format.
# Compatible with both native Git (core.hooksPath .githooks) and rycus86/githooks.
#
set -e

# Support standard Githooks disable flag
if [ -n "$GITHOOKS_DISABLE" ]; then
    exit 0
fi

YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

MSG_FILE="$1"
MSG=$(head -1 "$MSG_FILE")

# ---------------------------------------------------------------------------
# 1. Reject empty messages (only hard blocker)
# ---------------------------------------------------------------------------
if [ -z "$(echo "$MSG" | tr -d '[:space:]')" ]; then
    printf "${RED}[commit-msg] BLOCKED:${NC} Commit message cannot be empty.\n"
    exit 1
fi

# ---------------------------------------------------------------------------
# 2. Subject line length recommendation (<= 72 chars recommended, non-blocking)
# ---------------------------------------------------------------------------
SUBJECT_LEN=$(echo "$MSG" | wc -c | tr -d ' ')
if [ "$SUBJECT_LEN" -gt 73 ]; then
    printf "${YELLOW}[commit-msg] TIP:${NC} Subject line is %d chars. Keeping it under 72 chars is recommended for git log readability.\n" "$((SUBJECT_LEN - 1))"
fi

# ---------------------------------------------------------------------------
# 3. Conventional commit prefix (recommended, non-blocking)
# ---------------------------------------------------------------------------
VALID_PREFIX=$(echo "$MSG" | grep -cE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|wip|adr)(\(.+\))?!?:' || true)
if [ "$VALID_PREFIX" -eq 0 ]; then
    printf "${YELLOW}[commit-msg] TIP:${NC} Consider using a conventional prefix:\n"
    printf "  feat: fix: docs: test: refactor: chore: ci: build: perf: adr:\n"
    printf "  Example: feat(state): add atomic write with file lock\n"
fi
